{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.mts",
      "!node_modules/**",
      "!!website",
      "!!coverage",
      "!!.lagune",
      "!test/circular/dist.mjs"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "all"
    },
    "rules": {
      "preset": "none",
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessEscapeInRegex": "error"
      },
      "correctness": {
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalObjectCalls": "error",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noPrivateImports": "off",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredDependencies": "off",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnresolvedImports": "off",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "off",
        "useIsNan": "error",
        "useJsonImportAttributes": "off",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useYield": "error"
      },
      "style": {
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "useConsistentArrowReturn": "error",
        "useConst": "error",
        "useErrorCause": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCompareNegZero": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDeprecatedImports": "off",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": false
          }
        },
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noImportAssign": "error",
        "noImportCycles": "off",
        "noIrregularWhitespace": "error",
        "noMisleadingCharacterClass": "error",
        "noRedeclare": "error",
        "noSparseArray": "error",
        "noUnassignedVariables": "error",
        "noUnsafeNegation": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "noVar": "error",
        "noWith": "error",
        "useGetterReturn": "error",
        "useStrictMode": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.mts"],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "error",
            "noUselessThisAlias": "error",
            "noUselessTypeConstraint": "error"
          },
          "correctness": {
            "noConstAssign": "off",
            "noGlobalObjectCalls": "off",
            "noInvalidBuiltinInstantiation": "off",
            "noInvalidConstructorSuper": "off",
            "noSetterReturn": "off",
            "noUndeclaredVariables": "off",
            "noUnreachable": "off",
            "noUnreachableSuper": "off",
            "useImportExtensions": {
              "level": "error",
              "options": {
                "forceJsExtensions": true
              }
            }
          },
          "style": {
            "noCommonJs": "error",
            "noNamespace": "error",
            "noRestrictedTypes": {
              "level": "error",
              "options": {
                "types": {
                  "BigInt": { "message": "Use bigint instead." },
                  "Boolean": { "message": "Use boolean instead." },
                  "Function": {
                    "message": "Prefer an explicit function type, like () => void."
                  },
                  "Number": { "message": "Use number instead." },
                  "Object": { "message": "Use object instead." },
                  "String": { "message": "Use string instead." },
                  "Symbol": { "message": "Use symbol instead." }
                }
              }
            },
            "useArrayLiterals": "error",
            "useAsConstAssertion": "error",
            "useSpreadOverApply": "error"
          },
          "suspicious": {
            "noClassAssign": "off",
            "noDuplicateClassMembers": "off",
            "noDuplicateEnumValues": "error",
            "noDuplicateObjectKeys": "off",
            "noDuplicateParameters": "off",
            "noExtraNonNullAssertion": "error",
            "noFunctionAssign": "off",
            "noImportAssign": "off",
            "noMisleadingInstantiator": "error",
            "noNonNullAssertedOptionalChain": "error",
            "noRedeclare": "off",
            "noTsIgnore": "error",
            "noUnsafeDeclarationMerging": "error",
            "noUnsafeNegation": "off",
            "noUnusedExpressions": "error",
            "noWith": "off",
            "useGetterReturn": "off",
            "useNamespaceKeyword": "error",
            "useStrictMode": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.mts"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off"
          },
          "suspicious": {
            "noExplicitAny": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.mts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnusedExpressions": "off"
          }
        }
      }
    },
    {
      "includes": ["test/**/*.mts", "test/tsc-build/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "noRestrictedTypes": {
              "level": "error",
              "options": {
                "types": {
                  "BigInt": { "message": "Use bigint instead." },
                  "Boolean": { "message": "Use boolean instead." },
                  "Number": { "message": "Use number instead." },
                  "Object": { "message": "Use object instead." },
                  "String": { "message": "Use string instead." },
                  "Symbol": { "message": "Use symbol instead." }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["lib/packets/execute.js"],
      "linter": {
        "rules": {
          "style": {
            "noUselessElse": "off"
          }
        }
      }
    },
    {
      "includes": ["lib/server.js"],
      "javascript": {
        "globals": ["arguments"]
      }
    }
  ]
}
