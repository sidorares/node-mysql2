{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/build",
      "!**/.docusaurus",
      "!**/.cache-loader",
      "!**/*.svg"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "qwik": "none",
      "solid": "none"
    },
    "rules": {
      "preset": "all",
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noUselessFragments": "off"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noPrivateImports": "off",
        "noProcessGlobal": "off",
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "off",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noNamespaceImport": "off",
        "noReExportAll": "error",
        "useTopLevelRegex": "off"
      },
      "security": {
        "noGlobalEval": "error",
        "noSecrets": "off"
      },
      "style": {
        "noCommonJs": "off",
        "noDefaultExport": "off",
        "noIncrementDecrement": "off",
        "noJsxLiterals": "off",
        "noNonNullAssertion": "off",
        "noProcessEnv": "off",
        "noTernary": "off",
        "useBlockStatements": "off",
        "useConsistentArrowReturn": "off",
        "useConsistentTypeDefinitions": "off",
        "useDestructuring": "off",
        "useNamingConvention": "off",
        "useNodeAssertStrict": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAsyncPromiseExecutor": "error",
        "noConsole": "off",
        "noEmptyBlockStatements": "off",
        "noMisplacedAssertion": "off",
        "noReactSpecificProps": "off",
        "noShadow": "off",
        "useAwait": "error",
        "useIsArray": "error"
      }
    }
  }
}
